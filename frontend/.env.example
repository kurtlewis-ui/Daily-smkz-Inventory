# Base URL of the NestJS backend API (include the /api/v1 path).
# Local dev default is http://localhost:4000/api/v1
# In production, set this to your deployed backend, e.g.
#   Vercel backend: https://your-backend.vercel.app/api/v1
#   (legacy Render): https://your-backend.onrender.com/api/v1
# See backend/DEPLOYMENT-VERCEL.md for the Vercel + Supabase setup.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
