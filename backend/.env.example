# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database
# The connection string the RUNNING APP uses for all normal queries.
# On Supabase, prefer the TRANSACTION pooler (port 6543) here — it scales to
# many concurrent clients, which suits a multi-branch deployment:
#   postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/vape_shop_db?schema=public"

# OPTIONAL — connection used ONLY for boot-time migrations + seed.
# The transaction pooler (6543) can't run Prisma migrations, so when DATABASE_URL
# points at 6543, set this to the SESSION pooler / direct connection (port 5432):
#   postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:5432/postgres
# If left unset, migrations fall back to DATABASE_URL (correct for a single-URL
# setup where DATABASE_URL is already a 5432 connection).
# MIGRATE_DATABASE_URL=

# Set to "false" to skip in-app migrations entirely (e.g. if you run
# `prisma migrate deploy` from CI/a release step instead). Default: run on boot.
# RUN_MIGRATIONS_ON_BOOT=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
# Access-token lifetime. The frontend proactively refreshes well before this,
# so 60m keeps staff logged in through a shift without constant refreshing.
JWT_EXPIRATION=60m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
# The EXACT origin of the frontend (scheme + host, no trailing slash).
# In production set this to your custom domain, e.g. https://dailysmokzvs.com
CORS_ORIGIN=http://localhost:3000

# Refresh-token cookie (cross-site login). Defaults are correct for the common
# setup where the frontend and backend are on DIFFERENT domains (frontend on
# your custom domain, backend on *.onrender.com): sameSite=none + secure=true.
# Only set these to override — e.g. COOKIE_SAMESITE=lax if you put the API on a
# subdomain of the frontend.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Cloudinary (image storage) - Optional.
# When these 3 are set, product/brand/avatar images are uploaded to Cloudinary
# and only the resulting URL is stored in the database (keeps Postgres small).
# When they are NOT set, images fall back to being stored inline (base64) as
# before, so the app keeps working without Cloudinary configured.
# Get these from your Cloudinary dashboard (Product Environment Credentials).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Bcrypt
BCRYPT_ROUNDS=12

# Session
# Idle timeout in seconds; slides forward on each token refresh. 28800 = 8h so
# a staff member isn't logged out mid-shift.
SESSION_TIMEOUT=28800
SESSION_ABSOLUTE_TIMEOUT=28800

# Email (SendGrid) - Optional
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@vapeshop.com

# AWS S3 (for backups) - Optional
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=vape-shop-backups
AWS_REGION=us-east-1

# Monitoring - Optional
SENTRY_DSN=
